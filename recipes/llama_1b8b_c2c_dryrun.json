{
    "model": {
        "base_model": "meta-llama/Llama-3.2-1B-Instruct",
        "teacher_model": "meta-llama/Llama-3.1-8B-Instruct",
        "is_do_alignment": false,
        "alignment_strategy": "first",
        "projector": {
            "type": "C2CProjector",
            "params": {
                "hidden_dim": 1024,
                "intermediate_dim": 1024,
                "num_layers": 3,
                "dropout": 0.1,
                "initial_temperature": 1.0,
                "final_temperature": 0.001,
                "anneal_steps": 50
            }
        },
        "mapping": "last_aligned"
    },
    "training": {
        "learning_rate": 0.0001,
        "weight_decay": 0.01,
        "num_epochs": 1,
        "max_length": 2048,
        "device": "cuda",
        "scheduler_type": "linear",
        "warmup_ratio": 0.1,
        "max_grad_norm": 1.0,
        "gradient_accumulation_steps": 16,
        "per_device_train_batch_size": 2,
        "num_processes": 1,
        "freeze": [
            "teacher",
            "base"
        ],
        "seed": 42
    },
    "output": {
        "output_dir": "/home/ubuntu/turborag-fusion/C2C/local/checkpoints/llama_dryrun",
        "save_steps": 1000,
        "eval_steps": 1000,
        "wandb_config": {
            "project": "Rosetta-RAG",
            "mode": "offline",
            "entity": null,
            "run_name": "llama_dryrun"
        }
    },
    "data": {
        "type": "OpenHermesChatDataset",
        "kwargs": {
            "split": "train",
            "max_word_count": 2048,
            "num_samples": 200
        },
        "train_ratio": 0.99
    }
}